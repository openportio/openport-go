FROM debian:bookworm-slim
LABEL os=linux
LABEL arch=armhf

# CGO_ENABLED=0 (no cgo since the switch to modernc.org/sqlite) yields a
# fully static binary, so the build distro's glibc version does not matter
# for compatibility with old target systems.
RUN apt-get update && apt-get install -y --no-install-recommends \
        ca-certificates \
        wget \
        curl \
    && rm -rf /var/lib/apt/lists/*
RUN wget https://go.dev/dl/go1.26.8.linux-amd64.tar.gz && \
    rm -rf /usr/local/go &&  \
    tar -C /usr/local -xzf go1.26.8.linux-amd64.tar.gz
ENV PATH=$PATH:/usr/local/go/bin

ENV GOOS=linux
ENV GOARCH=arm
ENV GOARM=7
ENV CGO_ENABLED=0

COPY src/go.mod \
    src/go.sum \
    /apps/go/

WORKDIR /apps/go/

RUN go mod download
ENV GOCACHE=/go-cache
COPY src/ /apps/go/
ARG GIT_SHA=unknown
# Release version (e.g. 2.2.4); empty keeps the VERSION var compiled into the source.
ARG VERSION=
RUN --mount=type=cache,target=/go-cache go build -ldflags "-s -w -X github.com/openportio/openport-go.GitSha=${GIT_SHA}${VERSION:+ -X github.com/openportio/openport-go.VERSION=$VERSION}" -o /openport-armhf apps/openport/main.go
