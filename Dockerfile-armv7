FROM debian:bookworm-slim
LABEL os=linux
LABEL arch=armv7

# The binary is linked fully statically (see the build flags below), so the
# build distro's glibc version does not matter for compatibility with old
# target systems.
RUN apt-get update && apt-get install -y --no-install-recommends \
        ca-certificates \
        gcc-arm-linux-gnueabi \
        libc6-dev-armel-cross \
        wget \
        curl \
    && rm -rf /var/lib/apt/lists/*
RUN wget https://go.dev/dl/go1.26.8.linux-amd64.tar.gz && \
    rm -rf /usr/local/go &&  \
    tar -C /usr/local -xzf go1.26.8.linux-amd64.tar.gz
ENV PATH=$PATH:/usr/local/go/bin

ENV GOOS=linux
ENV GOARCH=arm
ENV GOARM=7
ENV CGO_ENABLED=1
ENV CC=arm-linux-gnueabi-gcc

COPY src/go.mod \
    src/go.sum \
    /apps/go/

WORKDIR /apps/go/

RUN go mod download
ENV GOCACHE=/go-cache
COPY src/ /apps/go/
ARG GIT_SHA=unknown
# Release version (e.g. 2.2.4); empty keeps the VERSION var compiled into the source.
ARG VERSION=
RUN --mount=type=cache,target=/go-cache go build -ldflags "-s -w -X github.com/openportio/openport-go.GitSha=${GIT_SHA}${VERSION:+ -X github.com/openportio/openport-go.VERSION=$VERSION} -extldflags=-static" -tags netgo,osusergo -o /openport-armv7 apps/openport/main.go
