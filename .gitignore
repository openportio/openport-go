### Go template
# Compiled Object files, Static and Dynamic libs (Shared Objects)
*.o
*.a
*.so

# Folders
_obj
_test

# Architecture specific extensions/prefixes
*.[568vq]
[568vq].out

*.cgo1.go
*.cgo2.c
_cgo_defun.c
_cgo_gotypes.go
_cgo_export.*

_testmain.go

*.exe
*.test
*.prof


openport-*
openportw-*
# but not the DB-migration fixtures created by old client versions
!src/database/testdata/openport-*.db
test.db
src/tmp/
test-results/

*.pyc
python_tests/tests/testfiles/tmp/*

# Generated SBOMs (published as CI artifacts / release assets, not committed)
sbom/
security-reports/

# generated keypair for python_tests/tests/old_versions upgrade test
test_id_rsa
test_id_rsa.pub

# client-generated key/config dirs from local runs -- these hold private keys
.openport/

# Release packaging output (packaging/build-debs.sh, packaging/publish-apt.sh)
dist/
packaging/build/
# The apt repo public key IS committed -- the openport-* pattern above would
# otherwise swallow it.
!packaging/openport-archive-keyring.asc
# Local environment files -- never commit (this repo is public); commit a
# matching .env.example instead.
.env
