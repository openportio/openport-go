# Local release-tooling config. Copy to packaging/.env (gitignored -- NEVER
# commit the real file, this repo is public).
#
# packaging/sign-release.sh and packaging/publish-apt.sh source this file as
# shell, so plain assignments, "${VAR:-default}" expansions, and sourcing other
# files all work. Write overridables as VAR="${VAR:-value}" so an explicitly
# exported variable still beats the file.

## Required by sign-release.sh: the GitLab instance holding the unsigned CI
## builds, and a read_api token for this project. If you keep them in a shared
## credentials file (GITLAB_URL=... / GITLAB_TOKEN=... shell format), source it
## instead of writing the token here:
#[ -n "${GITLAB_TOKEN:-}" ] || . "$HOME/.config/gitlab/credentials"
GITLAB_URL="${GITLAB_URL:-https://gitlab.example.com}"
GITLAB_TOKEN="${GITLAB_TOKEN:-glpat-your-read-api-token}"

## Everything below already has these defaults in the scripts -- uncomment to
## override.
#GITLAB_PROJECT="openport%2Fopenport-go-client"
#GITHUB_REPO="openportio/openport-go"
#GITHUB_REMOTE="github"
#PKG_NAME="openport-build"
#APT_SIGNING_KEY_FILE="$HOME/.openport-release/apt-signing-key.asc"
#POOL_ARCHIVE="$HOME/.openport-release/pool"
#EXTRA_ASSETS_DIR="$HOME/.openport-release/assets/$VERSION"
#RPM_SIGN_IMAGE="fedora:40"

## Legacy push publish (publish-apt.sh without SKIP_UPLOAD=1).
#RELEASE_HOST="openport"   # ssh alias / host
#RELEASE_SSH_PORT="22"
#RELEASE_SSH_KEY_FILE=""
