<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
<key>Label</key>
<string>io.openport</string>
<key>ProgramArguments</key>
<array>
<!-- The pkg installs to /usr/local/bin; the 2.2.1 daemon pointed at
     /usr/bin/openport, which never existed there. -->
<string>/usr/local/bin/openport</string>
<string>restart-sessions</string>
</array>
<key>RunAtLoad</key>
<true/>
</dict>
</plist>
