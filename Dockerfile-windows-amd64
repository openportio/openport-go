FROM debian:bookworm-slim
LABEL os=windows
LABEL arch=amd64

ENV GOVERSION="1.26.8"
ENV GOOS=windows
ENV GOARCH=amd64
ENV GOPATH=/go
ENV CGO_ENABLED=0
ENV PATH="/go/bin:/usr/local/go/bin:${PATH}"

# install build dependencies
RUN set -ex \
    && apt-get update \
    && apt-get install -y --no-install-recommends \
        ca-certificates \
        git \
        wget \
    && rm -rf /var/lib/apt/lists/*

# install golang
RUN set -ex \
    && wget -P /tmp -q https://dl.google.com/go/go$GOVERSION.linux-amd64.tar.gz \
    && tar -C /usr/local -xzf /tmp/go$GOVERSION.linux-amd64.tar.gz

COPY src/go.mod \
    src/go.sum \
    /apps/go/

WORKDIR /apps/go/

RUN go mod download
ENV GOCACHE=/go-cache
COPY src/ /apps/go/
ARG GIT_SHA=unknown
# Release version (e.g. 2.2.4); empty keeps the VERSION var compiled into the source.
ARG VERSION=
RUN --mount=type=cache,target=/go-cache go build -o /openport-windows-amd64.exe -ldflags "-s -w -X github.com/openportio/openport-go.GitSha=${GIT_SHA}${VERSION:+ -X github.com/openportio/openport-go.VERSION=$VERSION}" apps/openport/main.go
RUN --mount=type=cache,target=/go-cache go build -o /openportw-windows-amd64.exe -ldflags "-H=windowsgui -s -w -X github.com/openportio/openport-go.GitSha=${GIT_SHA}${VERSION:+ -X github.com/openportio/openport-go.VERSION=$VERSION}" apps/openport/main.go
RUN --mount=type=cache,target=/go-cache go build -o /openport-service-windows-amd64.exe -ldflags "-s -w -X github.com/openportio/openport-go.GitSha=${GIT_SHA}${VERSION:+ -X github.com/openportio/openport-go.VERSION=$VERSION}" apps/windows_service/main.go
