# Copy to .env in this directory (gitignored -- NEVER commit the real file,
# this repo is public). Read by docker compose for the python e2e test stack.
# Plain KEY=value lines only: docker compose parses this file itself.

# Token the test clients use to register against the test server
# (passed into the containers by docker-compose-test.yaml).
KEY_REGISTRATION_TOKEN=choose-any-secret
